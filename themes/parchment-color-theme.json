{
  "$schema": "vscode://schemas/color-theme",
  "name": "Mentl Parchment",
  "type": "light",
  "colors": {
    "editor.background": "#F5EDE0",
    "editor.foreground": "#1A1618",
    "editorCursor.foreground": "#7E5600",
    "editor.selectionBackground": "#E69F004D"
  },
  "tokenColors": [
    {
      "scope": ["comment.line.double-slash.mentl"],
      "settings": { "foreground": "#6E655D", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.declaration.mentl", "keyword.control.mentl"],
      "settings": { "foreground": "#004F82" }
    },
    {
      "scope": ["keyword.other.discipline.mentl"],
      "settings": { "foreground": "#873F72" }
    },
    {
      "scope": ["keyword.operator.pipe.mentl"],
      "settings": { "foreground": "#166A96", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.type.mentl"],
      "settings": { "foreground": "#7E5600" }
    },
    {
      "scope": ["entity.name.function.mentl"],
      "settings": { "foreground": "#00634A" }
    },
    {
      "scope": ["constant.numeric.mentl", "keyword.operator.hole.mentl", "keyword.operator.negation.mentl"],
      "settings": { "foreground": "#A04500" }
    },
    {
      "scope": ["string.quoted.double.mentl", "string.quoted.multi.mentl"],
      "settings": { "foreground": "#7A5C00" }
    },
    {
      "scope": ["punctuation.section.embedded.begin.mentl"],
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": ["punctuation.section.embedded.end.mentl"],
      "settings": { "foreground": "#1A1618" }
    },
    {
      "scope": ["variable.language.self.mentl"],
      "settings": { "foreground": "#A04500", "fontStyle": "italic" }
    }
  ]
}
